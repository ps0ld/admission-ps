# ---------- Backend (copy to backend/.env) ----------
# PostgreSQL connection (docker-compose provides this DB out of the box)
DATABASE_URL=postgresql+psycopg://admission:admission@localhost:5432/admission_ps

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Phase 4 (Google login): Firebase service account JSON path, kept OUT of git
FIREBASE_CREDENTIALS_FILE=

# Phase 5 (AI chatbot): server-side key only, never put it in the frontend
ANTHROPIC_API_KEY=

# Phase 6 (admin panel): comma-separated admin emails
ADMIN_EMAILS=

# ---------- Frontend (copy to frontend/.env) ----------
VITE_API_BASE_URL=http://localhost:8000
# Firebase web config (public identifiers, safe for the browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
